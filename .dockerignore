# Dependencies (em qualquer nível: raiz, backend/ e frontend/ipe-frontend/)
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
**/dist
build
coverage
*.tsbuildinfo

# Version control
.git
.gitignore
.gitattributes

# CI/CD & Tooling
.github
.husky
.vscode
.idea
.cache
.turbo
.nvmrc
.releaserc
.releaserc.json
.lintstagedrc.json
commitlint.config.js
eslint.config.mjs
.prettierrc
.prettierignore

# Documentation
docs
**/*.md
LICENSE

# Docker (evita contexto recursivo)
**/dockerfile
**/Dockerfile
**/docker-compose*.yml
.dockerignore

# Environment files (secrets): nunca entram na imagem
**/.env
**/.env.*
!**/.env.example

# Test artifacts
**/test
**/jest.config.js
**/jest-e2e.config.js
**/*.spec.ts
**/*.e2e-spec.ts

# IDE & OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Lock files de outros gerenciadores (mantém package-lock.json)
bun.lock
yarn.lock
pnpm-lock.yaml

# Código gerado pelo Prisma (recriado no build com `prisma generate`)
**/src/generated

# Pastas locais de ferramentas de IA (não fazem parte da aplicação)
**/skills-folder
