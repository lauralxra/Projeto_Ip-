# Normalizar final de linha (LF em todos os SOs — ESLint/Prettier exigem LF)
* text=auto eol=lf

# Arquivos TypeScript
*.ts text eol=lf

# Arquivos JSON
*.json text eol=lf

# Markdown
*.md text eol=lf

# Shell scripts e hooks do Husky
*.sh text eol=lf
.husky/* text eol=lf

# Windows scripts
*.bat text eol=crlf

# Optional
# *.ts linguist-language=TypeScript