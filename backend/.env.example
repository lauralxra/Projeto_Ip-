# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Segredo do JWT (mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET="troque-por-um-segredo-com-32-caracteres-ou-mais"
# Validade do access token (ex.: 15m, 1h, 1d)
JWT_EXPIRES_IN="1h"

# Credenciais iniciais do Administrador do Sistema (Seeding)
ADMIN_NAME="Administrador do Sistema"
ADMIN_EMAIL="admin@instituto-ipe.org.br"
ADMIN_PASSWORD="Admin@123456"

# Configurações de e-mail (SMTP via Resend)
# MAIL_PORT: 587 usa STARTTLS; 465 usa TLS direto
# MAIL_FROM: onboarding@resend.dev só entrega para o e-mail dono da conta Resend;
# em produção use um endereço de domínio verificado
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
MAIL_PASS=sua-api-key-do-resend
MAIL_FROM=onboarding@resend.dev

# URL base da aplicação frontend
APP_URL=http://localhost:5173
