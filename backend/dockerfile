# Contexto de build: raiz do repositório (ver docker-compose.yml)

# --- BASE: Node 22 (mesma versão do .nvmrc e do engines da raiz) ---
FROM node:22-alpine AS base
WORKDIR /app

# --- DEV: usado pelo docker-compose (hot reload, Prisma CLI e ferramentas de dev) ---
FROM base AS dev
COPY backend/package*.json ./
# --ignore-scripts: o postinstall roda `prisma generate`, que precisa do schema (copiado depois)
RUN npm ci --ignore-scripts
ENV NODE_ENV=development
EXPOSE 3000
CMD ["npm", "run", "start:dev"]

# --- BUILDER: compila o NestJS (gera o Prisma Client e a pasta dist/) ---
FROM base AS builder
COPY backend/package*.json ./
RUN npm ci --ignore-scripts
COPY backend/ ./
RUN npx prisma generate && npm run build

# --- RUNNER: imagem final de produção (somente dependências de produção) ---
FROM base AS runner
ENV NODE_ENV=production
COPY backend/package*.json ./
# bcrypt é módulo nativo: --ignore-scripts pula o download do binário, então reconstruímos
RUN npm ci --omit=dev --ignore-scripts && npm rebuild bcrypt
# O Prisma Client gerado (src/generated/prisma) já vai compilado dentro de dist/
COPY --from=builder /app/dist ./dist
USER node
EXPOSE 3000
CMD ["node", "dist/main.js"]
