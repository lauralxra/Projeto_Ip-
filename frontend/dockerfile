# Contexto de build: raiz do repositório (ver docker-compose.yml)

# --- BASE: Node 22 (mesma versão do .nvmrc) ---
FROM node:22-alpine AS base
WORKDIR /app

# --- DEV: Vite dev server com hot reload (usado pelo docker-compose) ---
FROM base AS dev
COPY frontend/ipe-frontend/package*.json ./
RUN npm ci
ENV NODE_ENV=development
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

# --- BUILDER: gera os arquivos estáticos (tsc -b && vite build) ---
FROM base AS builder
COPY frontend/ipe-frontend/package*.json ./
RUN npm ci
COPY frontend/ipe-frontend/ ./
RUN npm run build

# --- RUNNER: serve o build estático com Nginx (imagem final de produção) ---
FROM nginx:1.27-alpine AS runner
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
